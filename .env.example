# Variables exposées au frontend au moment du build (préfixe VITE_ obligatoire).
# Copiez vers `.env` (ou `.env.local`). Ces valeurs ne sont PAS secrètes.

# Clé publique (site key) Cloudflare Turnstile.
# Clé de TEST qui réussit toujours (dev uniquement) : 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
